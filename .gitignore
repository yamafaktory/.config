# Blacklist files/folders in same directory as the .gitignore file.
/*

# Whitelist some files.
!.gitignore

!bat/
bat/*
!bat/config

!fish/
fish/*
!fish/config.fish

!ghostty/
ghostty/*
!ghostty/config

!niri/
niri/*
!niri/config.kdl
!niri/noctalia.kdl

!noctalia/
noctalia/*
!noctalia/config.toml
!noctalia/palettes/
noctalia/palettes/*
!noctalia/palettes/*.json

!nvim/
nvim/*
!nvim/init.lua
!nvim/nvim-pack-lock.json

!git/
git/*
!git/config
!git/ignore

!install/
install/*
!install/install.sh
!install/packages.txt
!install/geforcenow.gpg
